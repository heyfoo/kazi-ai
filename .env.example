# Copy to .env.local. Everything is optional: with nothing set Kazi runs in template mode.

# ---- Writer (text generation) ----------------------------------------------
# auto (default) tries providers in this order: ollama -> groq -> openrouter -> gemini -> template.
# Force one with: ollama | groq | openrouter | gemini | mock
KAZI_LLM_PROVIDER=auto

# Local, free, private. Recommended on an 8 GB machine: a 3B model at Q4 (~2 GB RAM).
#   ollama pull qwen2.5:3b      (best small all-rounder)
#   ollama pull llama3.2:3b     (slightly better conversational English)
OLLAMA_HOST=http://127.0.0.1:11434
KAZI_OLLAMA_MODEL=qwen2.5:3b
KAZI_OLLAMA_NUM_CTX=6144

# Free cloud tiers (any one is enough). Keys are read from the environment only.
# GROQ_API_KEY=
# KAZI_GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_API_KEY=
# KAZI_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_API_KEY=
# KAZI_GEMINI_MODEL=gemini-2.5-flash

# ---- Decisions (fit screening, bullet grading, fabrication check) ------------
# TypeSafe Jev: typed, calibrated answers in one call, ~$0.04 per million input tokens.
# Without a key Kazi falls back to the writer LLM, then to keyword heuristics.
# TYPESAFE_API_KEY=
# JEV_API_KEY=            # alternative: hosted jv_live_ key from jevtypesafeai.com
# JEV_API_URL=            # override endpoint (defaults chosen from the key above)
# JEV_MODEL=jev-latest

# ---- Runtime -----------------------------------------------------------------
# Jobs processed at once. Keep at 1 for a local 3B model.
KAZI_CONCURRENCY=1
# Where resume, jobs and the content cache live.
KAZI_DATA_DIR=./data
